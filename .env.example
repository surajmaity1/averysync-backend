
# Note: In vscode, alwasy add single quote in PRIVATE_KEY & PUBLIC_KEY's value
# Other env variables work fine


# Note: For pycharm, remove single quote from all env variables

ENV='DEVELOPMENT'

PYTHONPATH=./backend

# DEBUG / ERROR_DETAILS are parsed as booleans: only 1/true/yes/on (any case)
# are truthy. Keep both off outside local development.
DEBUG='false'
ERROR_DETAILS='false'

# Generate a strong unique value; production refuses to start without it.
SECRET_KEY='SECRET_KEY'
BACKEND_BASE_URL='http://localhost:8000'
FRONTEND_BASE_URL='http://localhost:3000'

CORS_ALLOWED_ORIGINS='http://localhost:8000,http://localhost:3000'

SWAGGER_UI_PATH='/api/schema'

GOOGLE_OAUTH_CLIENT_ID='google-client-id'
GOOGLE_OAUTH_CLIENT_SECRET='google-client-secret'
GOOGLE_OAUTH_REDIRECT_URI='http://localhost:8000/v1/auth/google/callback'
# Comma-separated allowlist; only these values may override the OAuth redirect_uri.
GOOGLE_OAUTH_ALLOWED_REDIRECT_URIS='http://localhost:8000/v1/auth/google/callback'

POSTGRES_URI='postgresql://localhost:5432'

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=postgres_postgres

ACCESS_TOKEN_LIFETIME=ACCESS_TOKEN_LIFETIME
REFRESH_TOKEN_LIFETIME=REFRESH_TOKEN_LIFETIME
COOKIE_DOMAIN='localhost'
COOKIE_HTTPONLY=True
COOKIE_SECURE='true'
COOKIE_SAMESITE='Strict'

ACCESS_TOKEN_COOKIE_NAME='backend-access'
REFRESH_TOKEN_COOKIE_NAME='backend-refresh'

PRIVATE_KEY='PRIVATE_KEY'
PUBLIC_KEY='PUBLIC_KEY'
JWT_ISSUER='backend-app-auth'

# Required for WebRTC/Stream tokens; token generation fails if unset.
STREAM_API_SECRET_KEY='stream-api-secret'

COMMUNICATION_API='COMMUNICATION_API''